# Copy this file to devops/.env.compose before running the main stack.
#
# The main Compose stack does not run Mina or archive nodes. Point these at
# independently operated infrastructure.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=treasury_api

DATABASE_URL=postgres://postgres:__POSTGRES_PASSWORD__@postgres:5432/treasury_api
DATABASE_SCHEMA=public

# Default to localhost-only proxy ports. Set to 0.0.0.0 only behind a trusted
# firewall.
BIND_ADDRESS=127.0.0.1

# Container-to-host URL. Use host.docker.internal when archive runs on the Docker host.
ARCHIVE_NODE_URL=http://host.docker.internal:8282/graphql
# Browser-facing endpoints go through the web reverse proxy so the UI stays same-origin.
MINA_NODE_PROXY_UPSTREAM=http://host.docker.internal:8080
NEXT_PUBLIC_MINA_NODE_URL=/mina/graphql

TREASURY_OWNER_CONTRACT_ADDRESS=B62qpExe8CAaGkR4HRxyXvkziQpE6Aq3U71MJLHivP8pCsiDk1BbU9Z
# Optional. Defaults to TREASURY_OWNER_CONTRACT_ADDRESS in compose.yml.
# NEXT_PUBLIC_TREASURY_OWNER_CONTRACT_ADDRESS=

NEXT_PUBLIC_TREASURY_API_URL=/api
NEXT_PUBLIC_INDEXER_API_URL=/indexer
NEXT_PUBLIC_PROCESSOR_API_URL=/processor
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
NEXT_PUBLIC_LIFECYCLE_PERIOD_DURATION=7140
NEXT_PUBLIC_SLOT_DURATION_MS=180000
NEXT_PUBLIC_PROOFS_ENABLED=false
NEXT_PUBLIC_NETWORK_ID=MAINNET

# Local reverse proxy. Compose publishes only these host-facing app ports:
# - web: http://127.0.0.1:3100
# - API: http://127.0.0.1:4100
# - indexer API: http://127.0.0.1:4101
# - processor API: http://127.0.0.1:4102
#
# For public HTTPS with Let's Encrypt, set:
# LETSENCRYPT_EMAIL=ops@example.com
# PUBLIC_WEB_DOMAIN=treasury.example.com
# PUBLIC_API_DOMAIN=api.treasury.example.com
# PUBLIC_INDEXER_DOMAIN=indexer.treasury.example.com
# PUBLIC_PROCESSOR_DOMAIN=processor.treasury.example.com
# Optional dry-run CA:
# LETSENCRYPT_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
WEB_PORT=3100
PROXY_WEB_PORT=3100
PROXY_API_PORT=4100
PROXY_INDEXER_PORT=4101
PROXY_PROCESSOR_PORT=4102
PROXY_PUBLIC_BIND_ADDRESS=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

POLL_PENDING_INTERVAL_MS=5000
POLL_CANONICAL_INTERVAL_MS=15000
PROCESSOR_POLL_INTERVAL_MS=2000
PROOFS_ENABLED=false

SQLITE_DATA_HOST_PATH=./.data/sqlite
SQLITE_DATA_DIRECTORY=/data/sqlite
