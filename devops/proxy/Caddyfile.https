{
	email {$LETSENCRYPT_EMAIL}
	acme_ca {$LETSENCRYPT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

{$PUBLIC_WEB_DOMAIN} {
	encode zstd gzip

	redir /api /api/
	redir /indexer /indexer/
	redir /processor /processor/
	redir /mina /mina/

	handle_path /api/* {
		reverse_proxy api:4000
	}

	handle_path /indexer/* {
		reverse_proxy indexer-api:4001
	}

	handle_path /processor/* {
		reverse_proxy processor-api:4002
	}

	handle /mina/* {
		route {
			uri strip_prefix /mina

			@minaGraphiQL {
				path /graphql
				method GET
			}
			header @minaGraphiQL Content-Type "text/html; charset=utf-8"

			reverse_proxy {$MINA_NODE_PROXY_UPSTREAM}
		}
	}

	reverse_proxy web:{$WEB_PORT:3100}
}
