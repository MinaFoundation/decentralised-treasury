# Local blockchain Compose infrastructure env.
# Copy with: pnpm env:bootstrap local-blockchain
# Runtime-only copy: keep infrastructure credentials here, but do not store Mina private keys.

# Compose database settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=treasury_local_blockchain

# Local Caddy proxy ports
BIND_ADDRESS=127.0.0.1
WEB_PORT=3100
PROXY_WEB_PORT=3100
PROXY_API_PORT=4100
PROXY_INDEXER_PORT=4101
PROXY_PROCESSOR_PORT=4102
MINA_NODE_PROXY_UPSTREAM=__MINA_NODE_PROXY_UPSTREAM__

# Public HTTPS proxy profile
PROXY_PUBLIC_BIND_ADDRESS=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Mounted SQLite data
SQLITE_DATA_HOST_PATH=../.data/local-blockchain-sqlite
