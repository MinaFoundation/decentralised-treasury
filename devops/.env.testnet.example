# Local Mina testnet Compose infrastructure env.
# Copy with: pnpm env:bootstrap testnet
# Runtime-only copy: keep infrastructure credentials here, but do not store Mina private keys.

# Compose database settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=treasury_api

# Local Caddy proxy ports
BIND_ADDRESS=127.0.0.1
WEB_PORT=3100
PROXY_WEB_PORT=3100
PROXY_API_PORT=4100
PROXY_INDEXER_PORT=4101
PROXY_PROCESSOR_PORT=4102
MINA_NODE_PROXY_UPSTREAM=__MINA_NODE_PROXY_UPSTREAM__

# Public HTTPS proxy profile
PROXY_PUBLIC_BIND_ADDRESS=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
# For public HTTPS, set LETSENCRYPT_EMAIL and PUBLIC_*_DOMAIN values before running pnpm testnet:up:public.
# Optional staging CA: LETSENCRYPT_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Mounted SQLite data. On hosts with a dedicated mina service account, point
# this under that account's home directory (not inside the repo checkout, and
# not under /opt/mina/.mina-network since the Mina daemon can recreate/wipe
# that directory on restart) so it survives repo re-clones/redeploys and
# daemon restarts alike, e.g. /opt/mina/.treasury-sqlite.
SQLITE_DATA_HOST_PATH=../.data/testnet-sqlite

# Host directory the Mina daemon (or monitor-staking-ledger.sh) writes
# <epoch>-<hash>.tar.gz staking ledger snapshots into. Watched by the
# voting-ledger-scheduler service.
STAKING_LEDGERS_HOST_PATH=/opt/mina/.mina-network/staking_ledgers
