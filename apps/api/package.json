{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:indexer-worker": "node --loader ts-node/esm src/indexer.ts",
    "dev:processor-worker": "node --loader ts-node/esm src/processor.ts",
    "dev:indexer-api": "node --loader ts-node/esm src/indexer-api.ts",
    "dev:processor-api": "node --loader ts-node/esm src/processor-api.ts",
    "dev:api": "node --loader ts-node/esm src/app-api.ts",
    "dev:indexer": "pnpm dev:indexer-worker",
    "dev:processor": "pnpm dev:processor-worker",
    "dev": "pnpm dev:indexer-worker & pnpm dev:processor-worker & pnpm dev:indexer-api & pnpm dev:processor-api & pnpm dev:api",
    "start": "node --loader ts-node/esm src/app-api.ts",
    "start:indexer-worker": "node --loader ts-node/esm src/indexer.ts",
    "start:processor-worker": "node --loader ts-node/esm src/processor.ts",
    "start:indexer-api": "node --loader ts-node/esm src/indexer-api.ts",
    "start:processor-api": "node --loader ts-node/esm src/processor-api.ts",
    "start:indexer": "pnpm start:indexer-worker",
    "start:processor": "pnpm start:processor-worker",
    "start:api": "node --loader ts-node/esm src/app-api.ts",
    "typeorm": "typeorm-ts-node-esm -d src/db/typeorm-cli-data-source.ts",
    "schema:sync": "pnpm typeorm schema:sync",
    "schema:log": "pnpm typeorm schema:log",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "check-types": "tsc --noEmit",
    "test": "node --loader ts-node/esm --test \"test/**/*.test.ts\"",
    "test:e2e:lightnet": "RUN_LIGHTNET_E2E=true NODE_NO_WARNINGS=1 SLOT_TIME_MS=1000 LIGHTNET_LIFECYCLE_PERIOD_DURATION_SLOTS=420 node --loader ts-node/esm --test --test-concurrency=1 \"test/e2e/**/*.e2e.ts\"",
    "test:e2e:local-blockchain": "RUN_LOCAL_BLOCKCHAIN_E2E=true PROOFS_ENABLED=false NODE_NO_WARNINGS=1 node --loader ts-node/esm --test --test-concurrency=1 \"test/e2e/proposal-created-local-blockchain.e2e.ts\"",
    "fixtures:proposal-created:lightnet": "NODE_NO_WARNINGS=1 node --loader ts-node/esm scripts/lightnet/generate-proposal-created-fixtures.ts"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0",
    "@repo/indexer": "workspace:*",
    "@repo/processor": "workspace:*",
    "@repo/sdk": "workspace:*",
    "@types/express": "^5.0.3",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.26",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "pg-mem": "^3.0.14",
    "redis-memory-server": "^0.16.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "o1js": "github:maht0rz/o1js#feature/mesa-support"
  }
}