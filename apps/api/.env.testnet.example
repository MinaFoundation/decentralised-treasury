# Local Mina testnet API/indexer/processor env.
# Copy with: pnpm env:bootstrap testnet
# Runtime-only copy: no Mina private keys.

# Testnet infrastructure
ARCHIVE_NODE_URL=__COMPOSE_ARCHIVE_NODE_URL__

# Database settings
DATABASE_URL=__DATABASE_URL__
DATABASE_SCHEMA=public

# Service-to-service URLs
API_URL=http://api:4000
INDEXER_API_URL=http://indexer-api:4001
PROCESSOR_API_URL=http://processor-api:4002
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# Treasury lifecycle and proving settings
LIFECYCLE_PERIOD_DURATION=48
PROOFS_ENABLED=true
TREASURY_DEPLOYED_AT_SLOT=0

# Polling and mounted SQLite data
POLL_PENDING_INTERVAL_MS=5000
POLL_CANONICAL_INTERVAL_MS=15000
PROCESSOR_POLL_INTERVAL_MS=2000
SQLITE_DATA_DIRECTORY=/data/sqlite

# Treasury contract
TREASURY_OWNER_CONTRACT_ADDRESS=__TREASURY_OWNER_PUBLIC_KEY__
