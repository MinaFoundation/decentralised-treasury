# Lightnet archive endpoint is root path (not /graphql)
ARCHIVE_NODE_URL=http://127.0.0.1:8282
TREASURY_OWNER_CONTRACT_ADDRESS=B62...
TREASURY_OWNER_TOKEN_ID=...
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/treasury_indexer

# Optional
INDEXER_API_PORT=4000
INDEXER_API_URL=http://127.0.0.1:4000
POLL_PENDING_INTERVAL_MS=5000
POLL_CANONICAL_INTERVAL_MS=15000
EVENTS_BLOCK_BATCH_SIZE=10
CANONICAL_OVERLAP_BLOCKS=100
ORPHAN_DEPTH_BLOCKS=30
PROCESSOR_NAME=proposal-processor
PROCESSOR_POLL_INTERVAL_MS=2000
PROCESSOR_BATCH_SIZE=200
PROCESSOR_API_PORT=4100
PROCESSOR_API_PREFIX=v1/processor
API_PAGE_LIMIT_DEFAULT=50
API_PAGE_LIMIT_MAX=200
ARCHIVE_REQUEST_TIMEOUT_MS=15000
DATABASE_SCHEMA=public

# Optional lightnet e2e helpers
MINA_NODE_URL=http://127.0.0.1:8080/graphql
LIGHTNET_ACCOUNT_MANAGER_ENDPOINT=http://127.0.0.1:8181
