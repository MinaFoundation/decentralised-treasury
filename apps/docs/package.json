{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docusaurus start --port 3300",
    "build": "docusaurus build",
    "start": "docusaurus serve --port 3300",
    "clear": "docusaurus clear",
    "generate:runbooks": "node scripts/generate-infrastructure-runbooks.mjs",
    "validate:runbooks": "node scripts/generate-infrastructure-runbooks.mjs --check",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:coverage": "node scripts/validate-coverage.mjs",
    "validate:cli-reference": "pnpm --dir ../cli run test:docs-reference",
    "check:content": "node scripts/check.mjs",
    "check-types": "tsc --noEmit",
    "lint": "pnpm run validate:docs",
    "check": "pnpm run check:content && pnpm run validate:cli-reference && pnpm run check-types && pnpm run build"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "^3.1.1",
    "@mermaid-js/layout-elk": "^0.1.9",
    "@repo/ui": "workspace:*",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "typescript": "5.9.2"
  }
}
