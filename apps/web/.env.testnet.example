# Local Mina testnet web env.
# Copy with: pnpm env:bootstrap testnet
# Browser-facing runtime values. Do not add real private keys.

# Browser endpoints
NEXT_PUBLIC_TREASURY_API_URL=__NEXT_PUBLIC_TREASURY_API_URL__
NEXT_PUBLIC_INDEXER_API_URL=__NEXT_PUBLIC_INDEXER_API_URL__
NEXT_PUBLIC_PROCESSOR_API_URL=__NEXT_PUBLIC_PROCESSOR_API_URL__
NEXT_PUBLIC_MINA_NODE_URL=__NEXT_PUBLIC_MINA_NODE_URL__

# Treasury browser config
NEXT_PUBLIC_TREASURY_OWNER_CONTRACT_ADDRESS=__TREASURY_OWNER_PUBLIC_KEY__
NEXT_PUBLIC_LIFECYCLE_PERIOD_DURATION=48
NEXT_PUBLIC_SLOT_DURATION_MS=37500
NEXT_PUBLIC_PROOFS_ENABLED=true
NEXT_PUBLIC_NETWORK_ID=DEVNET

# Browser prover config. Fill from `treasury-owner compile`; bootstrap preserves existing values.
NEXT_PUBLIC_VOTE_REDUCER_VERIFICATION_KEY_JSON=__PRESERVE_NEXT_PUBLIC_VOTE_REDUCER_VERIFICATION_KEY_JSON__
NEXT_PUBLIC_STAKING_LEDGER_TO_VOTING_LEDGER_VERIFICATION_KEY_JSON=__PRESERVE_NEXT_PUBLIC_STAKING_LEDGER_TO_VOTING_LEDGER_VERIFICATION_KEY_JSON__
NEXT_PUBLIC_TREASURY_PROPOSAL_VERIFICATION_KEY_JSON=__PRESERVE_NEXT_PUBLIC_TREASURY_PROPOSAL_VERIFICATION_KEY_JSON__
NEXT_PUBLIC_EMPTY_VOTING_LEDGER_ROOT=__PRESERVE_NEXT_PUBLIC_EMPTY_VOTING_LEDGER_ROOT__
NEXT_PUBLIC_EMPTY_NULLIFIER_ROOT=__PRESERVE_NEXT_PUBLIC_EMPTY_NULLIFIER_ROOT__
