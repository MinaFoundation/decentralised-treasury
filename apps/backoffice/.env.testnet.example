# Local Mina testnet Backoffice env.
# Copy with: pnpm env:bootstrap testnet
# Browser-facing runtime values. Do not add real private keys.

NEXT_PUBLIC_NETWORK_ID=DEVNET
NEXT_PUBLIC_MINA_NODE_URL=http://127.0.0.1:3200/mina/graphql
NEXT_PUBLIC_BACKOFFICE_MINA_NODE_URL=http://127.0.0.1:3200/mina/graphql
NEXT_PUBLIC_TREASURY_OWNER_CONTRACT_ADDRESS=__TREASURY_OWNER_PUBLIC_KEY__
NEXT_PUBLIC_MULTISIG_PARTICIPANTS_PUBLIC_KEYS=__MULTISIG_PARTICIPANTS_PUBLIC_KEYS__
NEXT_PUBLIC_LIFECYCLE_PERIOD_DURATION=48

# Fill these values from `treasury-owner compile`.
# Bootstrap preserves existing Backoffice values and uses existing web values as its first fallback.
NEXT_PUBLIC_VOTE_REDUCER_VERIFICATION_KEY_JSON=__PRESERVE_BACKOFFICE_NEXT_PUBLIC_VOTE_REDUCER_VERIFICATION_KEY_JSON__
NEXT_PUBLIC_STAKING_LEDGER_TO_VOTING_LEDGER_VERIFICATION_KEY_JSON=__PRESERVE_BACKOFFICE_NEXT_PUBLIC_STAKING_LEDGER_TO_VOTING_LEDGER_VERIFICATION_KEY_JSON__
NEXT_PUBLIC_TREASURY_PROPOSAL_VERIFICATION_KEY_JSON=__PRESERVE_BACKOFFICE_NEXT_PUBLIC_TREASURY_PROPOSAL_VERIFICATION_KEY_JSON__
NEXT_PUBLIC_EMPTY_VOTING_LEDGER_ROOT=__PRESERVE_BACKOFFICE_NEXT_PUBLIC_EMPTY_VOTING_LEDGER_ROOT__
NEXT_PUBLIC_EMPTY_NULLIFIER_ROOT=__PRESERVE_BACKOFFICE_NEXT_PUBLIC_EMPTY_NULLIFIER_ROOT__
