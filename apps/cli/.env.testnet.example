# Local Mina testnet CLI env.
# Copy with: pnpm env:bootstrap testnet -- --sender-private-key <ONLINE_WHALE_PRIVATE_KEY>
# This file contains Mina private keys and is ignored by Git.

# Testnet infrastructure
MINA_NODE_URL=__MINA_NODE_URL__
ARCHIVE_NODE_URL=__ARCHIVE_NODE_URL__
TREASURY_API_URL=http://127.0.0.1:4100

# Treasury lifecycle and proving settings
LIFECYCLE_PERIOD_DURATION=48
PROOFS_ENABLED=true

# Shared SQLite data
SQLITE_DATA_DIRECTORY=./.data/testnet-sqlite

# Transaction defaults
TX_FEE=1000000000
TX_WAIT=true
TX_MEMO=testnet-deploy
ALLOW_DEPLOY_TO_EXISTING_ACCOUNT=false

# Sender account
SENDER_PRIVATE_KEY=__SENDER_PRIVATE_KEY__

# Treasury owner zkApp account
TREASURY_OWNER_PRIVATE_KEY=__TREASURY_OWNER_PRIVATE_KEY__
TREASURY_OWNER_PUBLIC_KEY=__TREASURY_OWNER_PUBLIC_KEY__
TREASURY_OWNER_CONTRACT_ADDRESS=__TREASURY_OWNER_PUBLIC_KEY__
NEXT_PUBLIC_TREASURY_OWNER_CONTRACT_ADDRESS=__TREASURY_OWNER_PUBLIC_KEY__

# Pause controller zkApp account
PAUSE_CONTROLLER_PRIVATE_KEY=__PAUSE_CONTROLLER_PRIVATE_KEY__
PAUSE_CONTROLLER_PUBLIC_KEY=__PAUSE_CONTROLLER_PUBLIC_KEY__

# Multisig participants
MULTISIG_PARTICIPANT_1_PRIVATE_KEY=__MULTISIG_PARTICIPANT_1_PRIVATE_KEY__
MULTISIG_PARTICIPANT_1_PUBLIC_KEY=__MULTISIG_PARTICIPANT_1_PUBLIC_KEY__
MULTISIG_PARTICIPANT_2_PRIVATE_KEY=__MULTISIG_PARTICIPANT_2_PRIVATE_KEY__
MULTISIG_PARTICIPANT_2_PUBLIC_KEY=__MULTISIG_PARTICIPANT_2_PUBLIC_KEY__
MULTISIG_PARTICIPANT_3_PRIVATE_KEY=__MULTISIG_PARTICIPANT_3_PRIVATE_KEY__
MULTISIG_PARTICIPANT_3_PUBLIC_KEY=__MULTISIG_PARTICIPANT_3_PUBLIC_KEY__
MULTISIG_PARTICIPANT_4_PRIVATE_KEY=__MULTISIG_PARTICIPANT_4_PRIVATE_KEY__
MULTISIG_PARTICIPANT_4_PUBLIC_KEY=__MULTISIG_PARTICIPANT_4_PUBLIC_KEY__
MULTISIG_PARTICIPANT_5_PRIVATE_KEY=__MULTISIG_PARTICIPANT_5_PRIVATE_KEY__
MULTISIG_PARTICIPANT_5_PUBLIC_KEY=__MULTISIG_PARTICIPANT_5_PUBLIC_KEY__
MULTISIG_PARTICIPANTS_PUBLIC_KEYS=__MULTISIG_PARTICIPANTS_PUBLIC_KEYS__
