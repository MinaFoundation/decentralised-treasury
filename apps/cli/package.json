    "test": "dotenvx run -f .env.test -- node --loader ts-node/esm --test"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.1",
    "@keyv/sqlite": "^4.0.8",
    "@repo/sdk": "workspace:*",
    "commander": "^14.0.0",
    "o1js": "git+https://github.com/maht0rz/o1js.git#feature/mesa-support"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "redis-memory-server": "^0.16.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2"
  }
}