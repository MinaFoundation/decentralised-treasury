{
  "name": "@repo/cli",
  "private": true,
  "type": "module",
  "bin": {
    "mina-treasury": "./bin/mina-treasury.cjs"
  },
  "scripts": {
    "cli:local": "NODE_NO_WARNINGS=1 dotenvx run -f .env.local -- node --loader ts-node/esm src/cli.ts",
    "mina-treasury": "node ./bin/mina-treasury.cjs",
