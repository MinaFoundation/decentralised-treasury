{
  "name": "@repo/sdk",
  "type": "module",
  "scripts": {
    "lightnet:start": "zkapp-cli lightnet start --mina-branch mesa",
    "lightnet:explorer": "zkapp-cli lightnet explorer",
    "run": "tsx",
    "chart:thresholds": "NODE_NO_WARNINGS=1 node --loader ts-node/esm scripts/generate-threshold-chart.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml up",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "test": "NODE_NO_WARNINGS=1 node --loader ts-node/esm --test",
    "test:all": "NODE_NO_WARNINGS=1 node --loader ts-node/esm --test ./test/**/*.test.ts",
    "test:watch": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--trace-uncaught' node --loader ts-node/esm --watch --test",
    "test:watch:all": "NODE_NO_WARNINGS=1 node --loader ts-node/esm --watch --test ./test/**/*.test.ts",
    "test:proofs-enabled": "NODE_NO_WARNINGS=1 PROOFS_ENABLED=true node --loader ts-node/esm --test",
    "test:proofs-enabled:all": "NODE_NO_WARNINGS=1 PROOFS_ENABLED=true node --loader ts-node/esm --test ./test/**/*.test.ts",
    "docker:build:local-o1js": "docker build -t decentralized-treasury-worker --progress=plain --file ./docker/worker.Dockerfile --build-context o1js=../../../o1js ."
  },
  "dependencies": {
    "@docker/node-sdk": "^0.0.11",
    "@dotenvx/dotenvx": "^1.51.1",
    "@inkjs/ui": "^2.0.0",
    "@keyv/sqlite": "^4.0.8",
    "@types/lodash": "^4.17.20",
    "add": "^2.0.6",
    "bullmq": "^5.63.0",
    "commander": "^14.0.0",
    "figures": "^6.1.0",
    "ink": "^6.5.1",
    "ink-progress-bar": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "ioredis": "^5.8.2",
    "keyv": "^5.6.0",
    "lodash": "^4.17.21",
    "loglevel": "^1.9.2",
    "pnpm": "^10.14.0",
    "react": "^19.1.0",
    "redis": "^5.10.0",
    "stream-json": "^1.9.1",
    "tsyringe": "^4.10.0",
    "zeromq": "^6.5.0",
    "zkapp-cli": "^0.23.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/keyv": "^4.2.0",
    "@types/node": "^22.15.3",
    "o1js": "file:/Users/maht0rz/Projects/mina-foundation/o1js",
    "redis-memory-server": "^0.14.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.20.4"
  },
