{
  "name": "@repo/processor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "node --loader ts-node/esm --test \"test/**/*.test.ts\"",
    "test:unit": "node --loader ts-node/esm --test \"test/**/*.test.ts\"",
    "test:coverage": "node ../../devops/scripts/run-node-test-coverage.mjs \"--include=src/**/*.ts\" \"--test-pattern=test/**/*.test.ts\""
  },
  "dependencies": {
    "@dataui/crud": "^5.3.4",
    "@dataui/crud-typeorm": "^5.3.4",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/typeorm": "^11.0.0",
    "@repo/indexer": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "pg-mem": "^3.0.14",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2"
  }
}
